generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Tool {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  icon        String
  rating      String
  description String
  pricing     String
  category    String
  url         String
  clicks      Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Submission {
  id          String   @id @default(cuid())
  name        String
  url         String
  category    String
  description String
  pricing     String
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}
